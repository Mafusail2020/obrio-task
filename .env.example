# ollama (local, free) or claude
LLM_PROVIDER=ollama

OLLAMA_MODEL=llama3.1
OLLAMA_HOST=http://localhost:11434

CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_EFFORT=low
ANTHROPIC_API_KEY=

# Optional second provider used when the primary is down: ollama | claude | empty
LLM_FALLBACK_PROVIDER=

# "latest" = highest prompts/vN.md
PROMPT_VERSION=latest
LLM_TIMEOUT_S=120
MAX_TICKET_CHARS=4000
